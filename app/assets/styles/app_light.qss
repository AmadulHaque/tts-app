/* Kokoro Studio — light theme */
QWidget {
    background-color: #f4f4f6;
    color: #1c1c22;
    font-size: 13px;
}

QMainWindow, QDialog { background-color: #f4f4f6; }

QTabWidget::pane { border: 1px solid #d5d5dd; border-top: none; background: #fbfbfd; }
QTabBar::tab {
    background: #e7e7ee; color: #555; padding: 7px 16px;
    border: 1px solid #d5d5dd; border-bottom: none;
    border-top-left-radius: 4px; border-top-right-radius: 4px; margin-right: 2px;
}
QTabBar::tab:selected { background: #fbfbfd; color: #9a5f10; }
QTabBar::tab:hover:!selected { background: #e0e0e8; }

QMenuBar { background: #fbfbfd; }
QMenuBar::item:selected { background: #e0e0e8; }
QMenu { background: #ffffff; border: 1px solid #d5d5dd; }
QMenu::item:selected { background: #e4edf7; }
QMenu::separator { height: 1px; background: #d5d5dd; margin: 4px 6px; }

QPushButton {
    background: #e7e7ee; color: #1c1c22;
    border: 1px solid #c9c9d4; border-radius: 5px;
    padding: 5px 12px;
}
QPushButton:hover { background: #dcdce4; }
QPushButton:pressed { background: #d0d0da; }
QPushButton:disabled { color: #999; background: #ededf1; }
QPushButton#primaryButton { background: #b9761f; color: #fff; border: none; font-weight: 600; }
QPushButton#primaryButton:hover { background: #cf8a2f; }
QPushButton#starButton { border: none; background: transparent; font-size: 16px; color: #b9761f; }

QComboBox, QLineEdit, QDoubleSpinBox, QSpinBox {
    background: #ffffff; color: #1c1c22;
    border: 1px solid #c9c9d4; border-radius: 4px; padding: 3px 6px;
}
QComboBox:hover, QLineEdit:focus, QDoubleSpinBox:focus { border: 1px solid #b9761f; }
QComboBox QAbstractItemView { background: #ffffff; selection-background-color: #e4edf7; }

QSlider::groove:horizontal { height: 5px; background: #d0d0da; border-radius: 2px; }
QSlider::handle:horizontal { background: #b9761f; width: 14px; margin: -4px 0; border-radius: 7px; }
QSlider::handle:horizontal:hover { background: #cf8a2f; }

QGroupBox {
    border: 1px solid #d5d5dd; border-radius: 6px; margin-top: 8px;
    padding-top: 8px; background: #fbfbfd;
}
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #9a5f10; }

QTableWidget {
    background: #ffffff; alternate-background-color: #f3f3f7;
    gridline-color: #e2e2ea; border: 1px solid #d5d5dd; border-radius: 4px;
    selection-background-color: #e4edf7;
}
QHeaderView::section {
    background: #e7e7ee; color: #333; border: none; border-right: 1px solid #d5d5dd;
    padding: 5px; font-weight: 600;
}
QTableCornerButton::section { background: #e7e7ee; border: none; }

QProgressBar {
    border: 1px solid #c9c9d4; border-radius: 4px; background: #ededf1; text-align: center;
}
QProgressBar::chunk { background-color: #b9761f; border-radius: 3px; }

QScrollBar:vertical { background: #f4f4f6; width: 10px; }
QScrollBar::handle:vertical { background: #c9c9d4; border-radius: 5px; min-height: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }

QFrame#voiceCard {
    background: #ffffff; border: 1px solid #d5d5dd; border-radius: 8px;
}
QFrame#voiceCard:hover { border-color: #b9761f; background: #fffcf5; }

QStatusBar { background: #fbfbfd; color: #555; }
QStatusBar::item { border: none; }

QToolTip { background: #ffffff; color: #1c1c22; border: 1px solid #c9c9d4; }

QMessageBox { background-color: #f4f4f6; }
